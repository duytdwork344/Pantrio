generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MeasurementType {
  COUNT
  WEIGHT
  VOLUME
}

enum QuantityConfidence {
  PRESENCE
  APPROXIMATE
  EXACT
}

enum StorageLocation {
  PANTRY
  FRIDGE
  FREEZER
  OTHER
}

enum InventoryTransactionType {
  PURCHASE
  CONSUME
  DISPOSE
  ADJUSTMENT
  ESTIMATED_CONSUME
}

enum RecipeDifficulty {
  EASY
  MEDIUM
  HARD
}

enum RecipeVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
  /// Cookbook nội bộ InventoryGroup — không lên Discover (xem requirements 4.2c).
  GROUP
}

enum RecipeModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Who wrote a translation (requirements 2b.2). MACHINE reserved for later.
enum TranslationOrigin {
  AUTHOR
  MODERATOR
  MACHINE
}

enum NutrientGroup {
  ENERGY
  MACRO
  CARB_DETAIL
  MINERAL
  VITAMIN
  OTHER
}

enum FoodVisibility {
  PUBLIC
  PRIVATE
}

enum ShoppingListItemStatus {
  PENDING
  PURCHASED
  SKIPPED
}

enum GroupMemberRole {
  OWNER
  MEMBER
}

enum ContentEventType {
  SHARE
  VIEW
}

/// Biometric sex for Mifflin–St Jeor (requirements 7b.10).
enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum NutritionTargetSource {
  COMPUTED
  MANUAL
  PRESET
}

enum NutritionPresetCode {
  CHILD_4_8
  CHILD_9_13
  TEEN_14_17
  ADULT_DEFAULT
  OLDER_65
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  /// Preferred UI/content locale (BCP-47, e.g. vi, en). Null = follow Accept-Language / default (requirements 2b.1).
  locale       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles               UserRole[]
  recipes             Recipe[]               @relation("RecipeAuthor")
  articles            Article[]              @relation("ArticleAuthor")
  savedRecipes        SavedRecipe[]
  plannedRecipes      PlannedRecipe[]
  shoppingLists       ShoppingList[]
  inventoryItems      InventoryItem[]
  inventoryTxns       InventoryTransaction[]
  cookingSessions     CookingSession[]
  createdFoods        Food[]                 @relation("FoodCreator")
  groupMemberships    GroupMembership[]
  ownedGroups         InventoryGroup[]       @relation("GroupCreator")
  contentEvents       ContentEvent[]
  nutritionTarget     UserNutritionTarget?
  recipeTranslations  RecipeTranslation[]    @relation("RecipeTranslator")
  articleTranslations ArticleTranslation[]   @relation("ArticleTranslator")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// Personal daily nutrition target (requirements 7b.10).
model UserNutritionTarget {
  userId     String                @id
  sex        Sex?
  ageYears   Int?
  weightKg   Float?
  heightCm   Float?
  activity   ActivityLevel         @default(MODERATE)
  source     NutritionTargetSource @default(COMPUTED)
  presetCode NutritionPresetCode?
  energyKcal Int
  proteinG   Int
  fatG       Int
  carbG      Int
  bmrKcal    Int?
  updatedAt  DateTime              @updatedAt
  createdAt  DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Food/ingredient master (PUBLIC catalog + PRIVATE user/creator drafts).
/// Display strings live in FoodTranslation (i18n).
model Food {
  id              String          @id @default(cuid())
  slug            String          @unique
  measurementType MeasurementType
  baseUnit        String
  imageUrl        String?
  visibility      FoodVisibility  @default(PUBLIC)
  createdByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  createdBy         User?              @relation("FoodCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  translations      FoodTranslation[]
  recipeIngredients RecipeIngredient[]
  inventoryItems    InventoryItem[]
  shoppingListItems ShoppingListItem[]
  nutrients         FoodNutrient[]

  @@index([visibility])
  @@index([createdByUserId])
}

model FoodTranslation {
  id       String  @id @default(cuid())
  foodId   String
  locale   String
  name     String
  category String?

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, locale])
  @@index([locale, name])
  @@index([locale, category])
}

/// Catalog of nutrients (seed). Values live on FoodNutrient — requirements 7b.9.
model Nutrient {
  id        String        @id @default(cuid())
  code      String        @unique
  unit      String
  group     NutrientGroup
  sortOrder Int           @default(0)

  translations  NutrientTranslation[]
  foodNutrients FoodNutrient[]
}

/// Display name per locale (requirements 2b.1 #2). Same pattern as FoodTranslation.
model NutrientTranslation {
  id         String @id @default(cuid())
  nutrientId String
  locale     String
  name       String

  nutrient Nutrient @relation(fields: [nutrientId], references: [id], onDelete: Cascade)

  @@unique([nutrientId, locale])
  @@index([locale])
}

model FoodNutrient {
  id         String @id @default(cuid())
  foodId     String
  nutrientId String
  amount     Float
  basisQty   Float  @default(100)
  basisUnit  String

  food     Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  nutrient Nutrient @relation(fields: [nutrientId], references: [id], onDelete: Cascade)

  @@unique([foodId, nutrientId])
  @@index([nutrientId])
}

model Recipe {
  id               String           @id @default(cuid())
  authorId         String
  /// When set, recipe is group cookbook (visibility must be GROUP).
  groupId          String?
  title            String
  slug             String           @unique
  description      String?
  servings         Int              @default(2)
  prepTimeMin      Int?
  cookTimeMin      Int?
  difficulty       RecipeDifficulty @default(EASY)
  instructions     String
  imageUrl         String?
  /// Short recipe video (MP4/WebM via MinIO). Optional sticky player on Web.
  videoUrl         String?
  visibility       RecipeVisibility @default(PUBLIC)
  /// Denormalized intent-share count (see ContentEvent SHARE).
  shareCount       Int              @default(0)
  /// Catalog only. Discover / cook read this revision. Null until first approve.
  publishedVersion Int?
  /// Language the author wrote first; fallback + "original" label (requirements 2b.2).
  /// title / description / instructions mirror this locale until the legacy columns are dropped.
  sourceLocale     String           @default("vi")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  author            User                   @relation("RecipeAuthor", fields: [authorId], references: [id])
  group             InventoryGroup?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  ingredients       RecipeIngredient[]
  steps             RecipeStep[]
  revisions         RecipeRevision[]
  tags              RecipeTag[]
  savedBy           SavedRecipe[]
  plannedBy         PlannedRecipe[]
  shoppingListItems ShoppingListItem[]
  cookingSessions   CookingSession[]
  inventoryTxns     InventoryTransaction[]
  articles          ArticleRecipe[]
  contentEvents     ContentEvent[]
  translations      RecipeTranslation[]

  @@index([authorId])
  @@index([groupId])
  @@index([title])
}

/// Localized text of a recipe (requirements 2b.2). A recipe "has" a locale when
/// this row exists and every step has a RecipeStepTranslation for it.
model RecipeTranslation {
  id             String            @id @default(cuid())
  recipeId       String
  locale         String
  title          String
  description    String?
  origin         TranslationOrigin @default(AUTHOR)
  translatedById String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  recipe       Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  translatedBy User?  @relation("RecipeTranslator", fields: [translatedById], references: [id], onDelete: SetNull)

  @@unique([recipeId, locale])
  @@index([locale])
}

/// Ordered instruction steps; optional per-step image (requirements 4.2e).
model RecipeStep {
  id        String  @id @default(cuid())
  recipeId  String
  sortOrder Int     @default(0)
  /// Mirror of the sourceLocale text (legacy); read RecipeStepTranslation.
  body      String
  imageUrl  String?

  recipe       Recipe                  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  translations RecipeStepTranslation[]

  @@index([recipeId, sortOrder])
}

/// Step text per locale; order and image stay on RecipeStep (shared by all locales).
model RecipeStepTranslation {
  id     String @id @default(cuid())
  stepId String
  locale String
  body   String

  step RecipeStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, locale])
}

/// One submitted catalog snapshot. Discover serves Recipe.publishedVersion only.
/// Group cookbook recipes do not use this table.
model RecipeRevision {
  id               String                 @id @default(cuid())
  recipeId         String
  version          Int
  moderationStatus RecipeModerationStatus
  title            String
  description      String?
  servings         Int
  prepTimeMin      Int?
  cookTimeMin      Int?
  difficulty       RecipeDifficulty
  instructions     String
  imageUrl         String?
  videoUrl         String?
  visibility       RecipeVisibility
  ingredientsJson  Json
  stepsJson        Json
  rejectReason     String?
  sourceLocale     String                 @default("vi")
  /// Snapshot of every locale's text: [{ locale, title, description, steps[], notes{foodId}, origin, translatedById }].
  /// Null on revisions saved before 2b — derive from title / description / stepsJson.
  translationsJson Json?
  createdAt        DateTime               @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, version])
  @@index([moderationStatus, createdAt])
}

model RecipeIngredient {
  id        String  @id @default(cuid())
  recipeId  String
  foodId    String
  quantity  Float
  unit      String
  /// Mirror of the sourceLocale note (legacy); read RecipeIngredientTranslation.
  note      String?
  optional  Boolean @default(false)
  sortOrder Int     @default(0)

  recipe       Recipe                        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  food         Food                          @relation(fields: [foodId], references: [id])
  translations RecipeIngredientTranslation[]

  @@unique([recipeId, foodId])
  @@index([foodId])
}

model RecipeIngredientTranslation {
  id           String @id @default(cuid())
  ingredientId String
  locale       String
  note         String

  ingredient RecipeIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, locale])
}

model Tag {
  id      String      @id @default(cuid())
  name    String      @unique
  recipes RecipeTag[]
}

model RecipeTag {
  recipeId String
  tagId    String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
}

model Article {
  id           String    @id @default(cuid())
  authorId     String
  title        String
  slug         String    @unique
  summary      String?
  body         String
  coverUrl     String?
  publishedAt  DateTime?
  /// Language the author wrote first. title / summary / body mirror it (legacy).
  sourceLocale String    @default("vi")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author       User                 @relation("ArticleAuthor", fields: [authorId], references: [id])
  recipes      ArticleRecipe[]
  translations ArticleTranslation[]

  @@index([authorId])
  @@index([title])
}

/// Recipes tagged / embedded in an Article (order via sortOrder).
/// Localized text of an article (requirements 2b.2).
model ArticleTranslation {
  id             String            @id @default(cuid())
  articleId      String
  locale         String
  title          String
  summary        String?
  body           String
  origin         TranslationOrigin @default(AUTHOR)
  translatedById String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  article      Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  translatedBy User?   @relation("ArticleTranslator", fields: [translatedById], references: [id], onDelete: SetNull)

  @@unique([articleId, locale])
  @@index([locale])
}

model ArticleRecipe {
  articleId String
  recipeId  String
  sortOrder Int    @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  recipe  Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([articleId, recipeId])
  @@index([recipeId])
}

/// Engagement events for learning feeds (intent share, later VIEW).
/// channel on SHARE is intent-level only (copy | native | …), not delivery proof.
model ContentEvent {
  id        String           @id @default(cuid())
  type      ContentEventType
  recipeId  String?
  userId    String?
  /// Intent channel: copy | native | facebook | x | unknown | …
  channel   String?
  createdAt DateTime         @default(now())

  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([recipeId, type, createdAt])
  @@index([userId, recipeId, type, createdAt])
}

model SavedRecipe {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

model PlannedRecipe {
  id         String    @id @default(cuid())
  userId     String
  recipeId   String
  servings   Int
  plannedFor DateTime?
  createdAt  DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId, plannedFor])
}

/// Shared household pantry + shopping scope (MVP: one membership per user).
model InventoryGroup {
  id              String    @id @default(cuid())
  name            String
  createdByUserId String
  inviteCode      String    @unique
  inviteExpiresAt DateTime?
  inviteMaxUses   Int?
  inviteUseCount  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy      User              @relation("GroupCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members        GroupMembership[]
  inventoryItems InventoryItem[]
  shoppingLists  ShoppingList[]
  recipes        Recipe[]

  @@index([inviteCode])
}

model GroupMembership {
  id       String          @id @default(cuid())
  groupId  String
  userId   String
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now())

  group InventoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// MVP: at most one active group per user.
  @@unique([userId])
  @@unique([groupId, userId])
  @@index([groupId])
}

model ShoppingList {
  id        String   @id @default(cuid())
  userId    String
  /// null = personal list; set = shared list for InventoryGroup.
  groupId   String?
  name      String   @default("Shopping List")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  group InventoryGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  items ShoppingListItem[]

  @@index([userId])
  @@index([groupId])
}

model ShoppingListItem {
  id             String                 @id @default(cuid())
  shoppingListId String
  foodId         String
  recipeId       String?
  quantity       Float
  unit           String
  status         ShoppingListItemStatus @default(PENDING)
  note           String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  food         Food         @relation(fields: [foodId], references: [id])
  recipe       Recipe?      @relation(fields: [recipeId], references: [id])

  @@index([shoppingListId, status])
  @@index([foodId])
}

/// One inventory batch/package (FEFO-friendly).
/// Personal: groupId null + userId = owner. Group: groupId set; userId = actor who created the batch.
model InventoryItem {
  id              String             @id @default(cuid())
  userId          String
  groupId         String?
  foodId          String
  quantity        Float
  unit            String
  confidence      QuantityConfidence @default(APPROXIMATE)
  expiryDate      DateTime?
  purchaseDate    DateTime?
  storageLocation StorageLocation    @default(PANTRY)
  opened          Boolean            @default(false)
  notes           String?
  lastConfirmedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group        InventoryGroup?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  food         Food                   @relation(fields: [foodId], references: [id])
  transactions InventoryTransaction[]

  @@index([userId, foodId])
  @@index([userId, expiryDate])
  @@index([groupId, foodId])
  @@index([groupId, expiryDate])
}

model InventoryTransaction {
  id               String                   @id @default(cuid())
  inventoryItemId  String
  userId           String
  type             InventoryTransactionType
  quantity         Float
  unit             String
  recipeId         String?
  cookingSessionId String?
  note             String?
  estimated        Boolean                  @default(false)
  createdAt        DateTime                 @default(now())

  inventoryItem  InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe         Recipe?         @relation(fields: [recipeId], references: [id])
  cookingSession CookingSession? @relation(fields: [cookingSessionId], references: [id])

  @@index([inventoryItemId, createdAt])
  @@index([userId, createdAt])
}

model CookingSession {
  id               String   @id @default(cuid())
  userId           String
  recipeId         String
  servings         Int
  cookedAt         DateTime @default(now())
  notes            String?
  /// Snapshot of consumption lines at cook time (needed / consumed / shortfall).
  consumptionsJson Json?

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe       Recipe                 @relation(fields: [recipeId], references: [id])
  transactions InventoryTransaction[]

  @@index([userId, cookedAt])
}
