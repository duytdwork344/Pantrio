DATABASE_URL="postgresql://pantrio:pantrio@localhost:5432/pantrio?schema=public"
JWT_SECRET="dev-change-me-pantrio-jwt-secret"
JWT_EXPIRES_IN="7d"
PORT=3001
# Desktop only. For mobile/LAN also add http://<your-lan-ip>:4200
CORS_ORIGIN="http://localhost:4200"
REDIS_URL="redis://localhost:6379"
# MinIO / S3-compatible object storage (media upload)
S3_ENDPOINT="http://localhost:9000"
# URL returned to clients (phone must reach this host). Use LAN IP when testing on device.
# Example: S3_PUBLIC_BASE_URL="http://192.168.x.x:9000"
S3_PUBLIC_BASE_URL="http://localhost:9000"
S3_ACCESS_KEY="pantrio"
S3_SECRET_KEY="pantriodev"
S3_BUCKET="pantrio-media"
S3_REGION="us-east-1"
